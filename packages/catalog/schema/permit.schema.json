{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sfhp:schema:permit",
  "title": "Permit Memo catalog file",
  "type": "object",
  "required": ["jurisdiction", "permits"],
  "additionalProperties": false,
  "properties": {
    "jurisdiction": {
      "type": "object",
      "required": ["level", "name"],
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["federal", "state", "city"] },
        "name": { "type": "string", "minLength": 2 },
        "state": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
        "city_slug": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]+$" },
        "county": { "type": ["string", "null"] },
        "supported": { "type": "boolean" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "permits": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/permit" }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      }
    },
    "rule": {
      "oneOf": [
        { "type": "object", "required": ["always"], "additionalProperties": false, "properties": { "always": { "const": true } } },
        { "type": "object", "required": ["all"], "additionalProperties": false, "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } } } },
        { "type": "object", "required": ["any"], "additionalProperties": false, "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } } } },
        { "type": "object", "required": ["not"], "additionalProperties": false, "properties": { "not": { "$ref": "#/$defs/rule" } } },
        {
          "type": "object",
          "required": ["field"],
          "additionalProperties": false,
          "properties": {
            "field": { "$ref": "#/$defs/profileField" },
            "eq": {}, "neq": {},
            "in": { "type": "array", "minItems": 1 },
            "not_in": { "type": "array", "minItems": 1 },
            "gt": { "type": "number" }, "gte": { "type": "number" },
            "lt": { "type": "number" }, "lte": { "type": "number" }
          },
          "minProperties": 2,
          "maxProperties": 2
        }
      ]
    },
    "profileField": {
      "enum": [
        "business_type", "city_slug", "state", "seats", "square_feet",
        "serves_food", "has_kitchen", "cooking_type",
        "serves_alcohol", "alcohol_type",
        "closes_after_midnight", "closes_after_2am",
        "live_entertainment", "amplified_sound", "dancing",
        "outdoor_seating", "sidewalk_or_parklet",
        "change_of_use", "tenant_improvements", "new_construction",
        "exterior_signage", "employees", "plays_recorded_music",
        "hotel_rooms", "mobile_vending", "sells_packaged_goods", "uses_commissary"
      ]
    },
    "permit": {
      "type": "object",
      "required": [
        "id", "name", "category", "issuing_agency", "jurisdiction_level",
        "typical_timeline_days", "fee_range_usd", "prerequisites", "applies_when",
        "application_url", "notes", "last_verified", "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]{2,6}\\.[a-z0-9]+(_[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 4, "maxLength": 120 },
        "category": {
          "enum": [
            "business_registration", "federal_tax", "state_tax", "local_tax",
            "health", "food_safety_cert", "building", "fire", "alcohol", "zoning",
            "signage", "grease", "entertainment", "outdoor_dining", "labor",
            "music_licensing", "hotel", "mobile_vending", "other"
          ]
        },
        "issuing_agency": { "type": "string", "minLength": 3 },
        "jurisdiction_level": { "enum": ["federal", "state", "county", "city"] },
        "typical_timeline_days": { "$ref": "#/$defs/range" },
        "fee_range_usd": { "$ref": "#/$defs/range" },
        "prerequisites": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]{2,6}\\.[a-z0-9]+(_[a-z0-9]+)*$" }, "uniqueItems": true },
        "applies_when": { "$ref": "#/$defs/rule" },
        "application_url": { "type": "string", "pattern": "^https://" },
        "notes": { "type": "string", "minLength": 10 },
        "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "confidence": { "enum": ["verified", "estimated"] },
        "sources": { "type": "array", "items": { "type": "string", "pattern": "^https://" } },
        "renewal": { "type": "string" },
        "stall_risk": { "type": "string", "description": "Why this permit commonly stalls and how to avoid it." }
      }
    }
  }
}
