<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Template of a launchd agent (macOS). Replace __REPO__ with the path of your checkout of this repository
     and __HOME__ with your home directory, then copy it to ~/Library/LaunchAgents/ and load it with
     launchctl bootstrap gui/$(id -u) <file>. The job needs DATA_REPO (see the run script). -->
<dict>
  <key>Label</key><string>org.example.sfhp.abc-backfill</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__REPO__/scripts/abc-archive/run-backfill.sh</string>
  </array>
  <!-- No schedule: started on demand with launchctl kickstart, so it outlives any terminal or session. -->
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/sfhp-abc-backfill.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/sfhp-abc-backfill.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
