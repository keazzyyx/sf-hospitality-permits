{
  "name": "showcase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The front end of SF Conditions Search (the living grid: the stamp gate, the story of one motion, the search beside the map) and its local pages.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "shots": "SHOTS=1 playwright test e2e/shots.spec.ts",
    "sizes": "node tools/sizes.mjs",
    "test:site": "playwright test -c playwright.site.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "lenis": "^1.3.27",
    "motion": "^14.14.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.187.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
