# ---- runtime ----
ENV=development                    # development | production
GIT_SHA=dev                        # set by CI/deploy; becomes the version tag on Neatlogs traces
LOG_LEVEL=INFO
PORT=8000
APP_NAME=Permit Memo               # the product name in reports, PDFs, e-mails and the API title
WEB_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (no JSON, no quotes), e.g. http://localhost:3000,https://app.example.org
CORS_ORIGINS=http://localhost:3000

# ---- observability (Neatlogs) ----
NEATLOGS_API_KEY=                  # required in production; when empty, export is disabled (local/CI)
NEATLOGS_ENDPOINT=                 # optional; defaults to Neatlogs cloud

# ---- model layer (Anthropic only) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_MAIN=claude-sonnet-4-5     # intake / requirements / timeline / blocker
ANTHROPIC_MODEL_TRIAGE=claude-haiku-4-5    # triage router
ANTHROPIC_MAX_TOOL_TURNS=8
ANTHROPIC_FORCE_TOOL_CHOICE=true   # set false on model generations that reject forced tool_choice (Opus 5.5 / Sonnet 5.5)

# ---- Supabase ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=         # server-side only, never shipped to the browser
SUPABASE_JWT_SECRET=               # Project Settings → API → JWT secret (HS256). Leave empty if your project uses asymmetric JWT signing keys; the API then verifies via JWKS.
SUPABASE_JWT_AUDIENCE=authenticated   # expected `aud` claim on Supabase access tokens

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PLAN=price_...        # $29 one-time "Single plan"
STRIPE_PRICE_SUBSCRIPTION=price_... # $49 / month "Unlimited"
FREE_PLAN_LIMIT=3

# ---- Location Risk Memo / precedent data ----
PRECEDENT_DATABASE_URL=            # Supabase → Project Settings → Database → connection string (session pooler). Empty = local JSONL store in PRECEDENT_DATA_DIR
PRECEDENT_DATA_DIR=../../data
MEMO_COVERAGE_CITIES=san_francisco # comma-separated catalog slugs the memo product covers
FREE_TEASER_LIMIT=2                # teaser memos a free account may generate
STRIPE_PRICE_MEMO=price_...        # $499 one-time Operator memo credit
STRIPE_PRICE_PRO=price_...         # $299 / month Pro (unlimited memos + bulk CSV)
ADMIN_EMAILS=you@example.com       # comma-separated; these accounts see /v1/admin/*
RESEND_API_KEY=                    # 90-day outcome feedback emails (skipped when empty)
FEEDBACK_FROM_EMAIL=                # sender on a domain verified in Resend; feedback emails are skipped when empty
FEEDBACK_TOKEN_SECRET=             # signs feedback links; falls back to SUPABASE_JWT_SECRET
FEEDBACK_DELAY_DAYS=90
GEOCODE_RATE_LIMIT_PER_MINUTE=60

# ---- misc ----
PREVIEW_RATE_LIMIT_PER_HOUR=10
LEADS_RATE_LIMIT_PER_HOUR=20
# answer rounds on a memo (POST /v1/memos/{id}/answers), per signed-in account
MEMO_ANSWERS_RATE_LIMIT_PER_HOUR=20
WEB_VERIFY_ENABLED=true
WEB_VERIFY_TIMEOUT_SECONDS=6
USER_ID_HASH_SALT=change-me        # salts the hashed user_id span attribute

# Extracted opposition flag in tools and memos. Off until it passes a 30-row check of its readings with 27+ right.
REPORT_OPPOSITION_FLAG=false
