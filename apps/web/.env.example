# Supabase (auth). Leave both empty and the app still builds/runs; sign-in shows a "not configured" notice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI backend (apps/api). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public origin of this web app; used for metadata/OG. Auth + Stripe redirects use window.location.origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog (optional). When the key is empty every analytics call is a no-op.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Public contact address shown in the footer, terms, privacy and error pages. Empty: no address shown.
NEXT_PUBLIC_CONTACT_EMAIL=
